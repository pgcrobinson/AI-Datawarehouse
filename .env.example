# ── Server URLs ────────────────────────────────────────────────────────────────
# Set both to your VM's public IP (or HTTPS domain if you add TLS later).
# The setup-vm.sh script fills these in automatically.
# Example: FRONTEND_URL=http://20.1.2.3
FRONTEND_URL=http://YOUR_VM_IP
BACKEND_URL=http://YOUR_VM_IP

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-before-deploying

# ── Webhook ────────────────────────────────────────────────────────────────────
# Paste the secret you configure in GitHub → Settings → Webhooks.
# Run: openssl rand -hex 32   to generate one.
GITHUB_WEBHOOK_SECRET=

# ── Frontend build-time (nginx proxy mode) ─────────────────────────────────────
# Leave empty so API calls use relative /api paths — nginx routes them to backend.
# Change only if you run frontend and backend on different domains.
NEXT_PUBLIC_API_URL=

# ── Google BigQuery OAuth ──────────────────────────────────────────────────────
# Required to use "Connect with Google" for BigQuery.
# Create an OAuth 2.0 Client ID in Google Cloud Console:
#   APIs & Services → Credentials → Create Credentials → OAuth client ID
#   Application type: Web application
#   Authorised redirect URI: https://YOUR_DOMAIN/api/database/bigquery/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Anthropic (AI design features) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
