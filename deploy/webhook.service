[Unit]
Description=GitHub Webhook Auto-Deploy Listener
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=azureuser
WorkingDirectory=/opt/app/deploy
ExecStart=/usr/bin/python3 /opt/app/deploy/webhook.py
Restart=always
RestartSec=5
# Picks up GITHUB_WEBHOOK_SECRET, FRONTEND_URL, BACKEND_URL, etc.
EnvironmentFile=/opt/app/.env
Environment=REPO_DIR=/opt/app
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
