# ── Required ──────────────────────────────────────────────────────────────────

# A long random string used to sign JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# URL(s) of the deployed frontend — used for CORS.
# Multiple origins can be comma-separated.
FRONTEND_URL=https://your-app.azurestaticapps.net

# Initial sysadmin account created on first run (only used when the database is empty).
# Change these before deploying — every deployment should have unique credentials.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-before-deploying

# ── Storage ───────────────────────────────────────────────────────────────────

# Root directory for SQLite database and dbt project files.
# On Azure App Service /home is the persistent mount — leave as-is.
DATA_DIR=/home/data

# ── Google BigQuery OAuth (required for "Connect with Google" button) ─────────

# Create an OAuth 2.0 Client ID in Google Cloud Console:
#   APIs & Services → Credentials → Create Credentials → OAuth client ID
#   Application type: Web application
#   Authorised redirect URIs: https://your-backend/api/database/bigquery/oauth/callback
#
# For local dev add:  http://localhost:8000/api/database/bigquery/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Public URL of this backend — used to build the OAuth redirect URI.
# Defaults to http://localhost:8000 if omitted.
BACKEND_URL=https://your-backend.azurewebsites.net

# ── Optional ──────────────────────────────────────────────────────────────────

# Anthropic API key — used by the AI design and transform features.
ANTHROPIC_API_KEY=sk-ant-...
